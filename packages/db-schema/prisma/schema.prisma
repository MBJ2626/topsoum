generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  credentials
  google
  facebook
}

enum StockStatus {
  in_stock
  out_of_stock
  unknown
}

enum PendingMatchStatus {
  pending
  approved
  rejected
  merged
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String?      @map("password_hash")
  emailVerified DateTime?    @map("email_verified")
  image         String?
  authProvider  AuthProvider @default(credentials) @map("auth_provider")
  isAdmin       Boolean      @default(false) @map("is_admin")
  createdAt     DateTime     @default(now()) @map("created_at")

  favorites Favorite[]
  accounts  Account[]
  sessions  Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Product {
  id            String   @id @default(cuid())
  brand         String
  model         String
  category      String
  specs         Json     @default("{}")
  canonicalName String   @unique @map("canonical_name")
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  offers    Offer[]
  favorites Favorite[]

  pendingMatchesAsCreated   PendingMatch[]   @relation("PendingMatchCreatedProduct")
  pendingMatchesAsCandidate PendingMatch[]   @relation("PendingMatchCandidateProduct")
  manualOverrides           ManualOverride[]

  @@index([category])
  @@index([brand, model])
  @@map("products")
}

model Vendor {
  id              String   @id @default(cuid())
  name            String   @unique
  logo            String?
  trustScore      Float?   @map("trust_score")
  avgDeliveryTime Int?     @map("avg_delivery_time")
  createdAt       DateTime @default(now()) @map("created_at")

  offers      Offer[]
  scraperRuns ScraperRun[]

  @@map("vendors")
}

model Offer {
  id           String      @id @default(cuid())
  productId    String      @map("product_id")
  vendorId     String      @map("vendor_id")
  price        Decimal     @db.Decimal(10, 3)
  stockStatus  StockStatus @default(unknown) @map("stock_status")
  url          String
  shippingCost Decimal?    @db.Decimal(10, 3) @map("shipping_cost")
  scrapedAt    DateTime    @map("scraped_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]

  @@unique([productId, vendorId])
  @@index([productId])
  @@index([vendorId])
  @@map("offers")
}

model PriceHistory {
  id         String   @id @default(cuid())
  offerId    String   @map("offer_id")
  price      Decimal  @db.Decimal(10, 3)
  recordedAt DateTime @default(now()) @map("recorded_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  // Un releve par offre et par horodatage de scraping : recharger le meme
  // fichier scrape dans l'ETL ne doit pas dupliquer l'historique.
  @@unique([offerId, recordedAt])
  @@map("price_history")
}

model Favorite {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  productId     String   @map("product_id")
  priceTracking Boolean  @default(false) @map("price_tracking")
  createdAt     DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model ScraperRun {
  id                String    @id @default(cuid())
  vendorId          String    @map("vendor_id")
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  productsCollected Int       @default(0) @map("products_collected")
  successCount      Int       @default(0) @map("success_count")
  errorCount        Int       @default(0) @map("error_count")
  createdAt         DateTime  @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, startedAt])
  @@map("scraper_runs")
}

model PendingMatch {
  id                 String             @id @default(cuid())
  vendorSlug         String             @map("vendor_slug")
  externalId         String?            @map("external_id")
  reference          String?
  offerProductName   String             @map("offer_product_name")
  category           String
  createdProductId   String             @map("created_product_id")
  candidateProductId String             @map("candidate_product_id")
  confidence         Float
  strategy           String
  status             PendingMatchStatus @default(pending)
  resolvedProductId  String?            @map("resolved_product_id")
  resolvedAt         DateTime?          @map("resolved_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  createdProduct   Product @relation("PendingMatchCreatedProduct", fields: [createdProductId], references: [id], onDelete: Cascade)
  candidateProduct Product @relation("PendingMatchCandidateProduct", fields: [candidateProductId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("pending_matches")
}

model ManualOverride {
  id         String   @id @default(cuid())
  vendorSlug String   @map("vendor_slug")
  externalId String?  @map("external_id")
  reference  String?
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("manual_overrides")
}
